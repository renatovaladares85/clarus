#: src/Inspector/InspectionRenderer.php:211
msgid ""
"This value cannot be reconstructed defensibly from the persisted Ticket "
"state."
msgstr ""
"Este valor não pode ser reconstruído de forma defensável a partir do estado "
"persistido do chamado."

#: src/Inspector/InspectionRenderer.php:213
msgid "This criterion is not part of the reconstructable Ticket context."
msgstr "Este critério não faz parte do contexto reconstruível do chamado."

#: src/Inspector/InspectionRenderer.php:215
msgid "Native RuleTicket criterion evaluation did not return a result."
msgstr "A avaliação nativa do critério RuleTicket não retornou resultado."

#: src/Inspector/InspectionRenderer.php:217
msgid "The rule uses an unsupported native matching mode."
msgstr "A regra usa um modo nativo de correspondência não suportado."

#: src/Inspector/InspectionRenderer.php:219
msgid "Native Rule processing rejects rules without criteria."
msgstr "O processamento nativo de regras rejeita regras sem critérios."

#: src/Inspector/InspectionRenderer.php:221
msgid ""
"Update eligibility depends on the original change set, which is not present "
"on a persisted Ticket."
msgstr ""
"A elegibilidade de atualização depende do conjunto original de alterações, "
"que não está presente em um chamado persistido."

#: src/Inspector/InspectionRenderer.php:223
msgid ""
"Results describe the current reconstructable Ticket state, not historical "
"rule execution."
msgstr ""
"Os resultados descrevem o estado atual reconstruível do chamado, não a "
"execução histórica de regras."

#: src/Inspector/InspectionRenderer.php:225
msgid "Configured rule actions are never executed by inspection."
msgstr "As ações configuradas das regras nunca são executadas pela inspeção."

#: src/Inspector/InspectionRenderer.php:227
msgid ""
"Action reflection describes only the current Ticket snapshot, not historical "
"causality."
msgstr ""
"A reflexão de ações descreve apenas o retrato atual do chamado, não "
"causalidade histórica."

#: src/Inspector/InspectionRenderer.php:229
msgid "Configured rule actions were not included in this inspection."
msgstr "As ações configuradas das regras não foram incluídas nesta inspeção."

#: src/Inspector/InspectionRenderer.php:231
msgid "The configured action is invalid and cannot be evaluated."
msgstr "A ação configurada é inválida e não pode ser avaliada."

#: src/Inspector/InspectionRenderer.php:233
msgid ""
"The configured action value is invalid for a safe current-state comparison."
msgstr ""
"O valor da ação configurada é inválido para uma comparação segura do estado "
"atual."

#: src/Inspector/InspectionRenderer.php:235
msgid "The current Ticket value is unavailable for comparison."
msgstr "O valor atual do chamado não está disponível para comparação."

#: src/Inspector/InspectionRenderer.php:237
msgid "The current Ticket value is invalid for comparison."
msgstr "O valor atual do chamado é inválido para comparação."

#: src/Inspector/InspectionRenderer.php:239
msgid "The action requires runtime input that cannot be reconstructed."
msgstr "A ação requer uma entrada de execução que não pode ser reconstruída."

#: src/Inspector/InspectionRenderer.php:241
msgid "The regular-expression capture result cannot be reconstructed."
msgstr "O resultado da captura de expressão regular não pode ser reconstruído."

#: src/Inspector/InspectionRenderer.php:243
msgid "The historical priority matrix input is unavailable."
msgstr "A entrada histórica da matriz de prioridade não está disponível."

#: src/Inspector/InspectionRenderer.php:245
msgid "The runtime lookup result cannot be reconstructed."
msgstr "O resultado da busca em tempo de execução não pode ser reconstruído."

#: src/Inspector/InspectionRenderer.php:247
msgid "The validation side effect cannot be reconstructed."
msgstr "O efeito colateral de validação não pode ser reconstruído."

#: src/Inspector/InspectionRenderer.php:249
msgid "The transient processing state cannot be reconstructed."
msgstr "O estado transitório de processamento não pode ser reconstruído."

#: src/Inspector/InspectionRenderer.php:251
msgid "The template execution result cannot be reconstructed."
msgstr "O resultado da execução de modelo não pode ser reconstruído."

#: src/Inspector/InspectionRenderer.php:253
msgid "The special relation semantics are not supported by this inspection."
msgstr "A semântica de relação especial não é suportada por esta inspeção."

#: src/Inspector/InspectionRenderer.php:255
msgid "The action semantics are not supported by this inspection."
msgstr "A semântica da ação não é suportada por esta inspeção."

