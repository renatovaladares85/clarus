<div class="container-xl clarus-config">
  <div class="card">
    <div class="card-header"><h2 class="card-title">{{ labels.title }}</h2></div>
    <form method="post" action="{{ action }}" data-track-changes="true">
      <div class="card-body">
        {% if error is not null %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
        <p class="text-muted">{{ labels.description }}</p>

        {% for field in booleanFields %}
          <input type="hidden" name="{{ field.name }}" value="0">
          <label class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" name="{{ field.name }}" value="1"{% if field.checked %} checked{% endif %}>
            <span class="form-check-label">{{ field.label }}</span>
          </label>
        {% endfor %}

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="clarus-rule-limit">{{ labels.ruleLimit }}</label>
            <input class="form-control" id="clarus-rule-limit" type="number" min="1" max="{{ maxRuleLimit }}"
                   name="inspection_rule_limit" value="{{ config.inspection_rule_limit }}" required>
            <div class="form-hint">{{ labels.ruleLimitHint }}</div>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="clarus-page-size">{{ labels.pageSize }}</label>
            <select class="form-select" id="clarus-page-size" name="inspection_page_size">
              {% for option in pageSizeOptions %}
                <option value="{{ option }}"{% if option == config.inspection_page_size %} selected{% endif %}>{{ option }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="clarus-initial-group">{{ labels.initialGroup }}</label>
            <select class="form-select" id="clarus-initial-group" name="inspection_initial_group">
              {% for value, label in groupOptions %}
                <option value="{{ value }}"{% if value == config.inspection_initial_group %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="clarus-minimum-adherence">{{ labels.minimumAdherence }}</label>
            <input class="form-control" id="clarus-minimum-adherence" type="number" min="0" max="100"
                   name="inspection_min_adherence" value="{{ config.inspection_min_adherence }}" required>
            <div class="form-hint">{{ labels.minimumAdherenceHint }}</div>
          </div>
        </div>
        <fieldset class="mt-3">
          <legend class="h4">{{ labels.initialSort }}</legend>
          {% for level in sortLevels %}
            <div class="row g-2 align-items-end mb-2">
              <div class="col-md-8">
                <label class="form-label" for="clarus-sort-field-{{ loop.index }}">{{ labels.sortLevel|format(loop.index) }}</label>
                <select class="form-select" id="clarus-sort-field-{{ loop.index }}" name="inspection_sort_{{ loop.index }}_field">
                  <option value="">{{ labels.noSort }}</option>
                  {% for value, label in sortOptions %}
                    <option value="{{ value }}"{% if value == level.field %} selected{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="clarus-sort-direction-{{ loop.index }}">{{ labels.initialSort }}</label>
                <select class="form-select" id="clarus-sort-direction-{{ loop.index }}" name="inspection_sort_{{ loop.index }}_direction">
                  <option value="asc"{% if level.direction == 'asc' %} selected{% endif %}>{{ labels.ascending }}</option>
                  <option value="desc"{% if level.direction == 'desc' %} selected{% endif %}>{{ labels.descending }}</option>
                </select>
              </div>
            </div>
          {% endfor %}
        </fieldset>
      </div>
      <div class="card-footer text-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrfToken }}">
        <button class="btn btn-primary" type="submit" name="update" value="1">
          <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ labels.save }}
        </button>
      </div>
    </form>
  </div>
</div>
