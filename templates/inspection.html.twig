<section class="clarus-inspection" data-clarus-inspection data-page-size="{{ pageSize }}" data-minimum-adherence="{{ minimumAdherence }}" data-initial-group="{{ initialGroup }}"
         data-label-showing="{{ labels.showing }}" data-label-of="{{ labels.of }}" data-label-rules="{{ labels.rules }}"
         data-label-previous="{{ labels.previous }}" data-label-next="{{ labels.next }}"
         data-label-group-result="{{ labels.groupResult }}" data-label-group-entity="{{ labels.groupEntity }}">
  <div class="clarus-inspection__header">
    <div>
      <h2 class="clarus-inspection__title">{{ labels.title }}</h2>
      <p class="text-muted mb-0">{{ labels.description }}</p>
    </div>
    <form class="clarus-inspection__refresh" method="post" action="{{ refreshUrl }}" data-clarus-refresh-form>
      <input type="hidden" name="tickets_id" value="{{ ticketId }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrfToken }}">
      <button class="btn btn-primary" type="submit" data-clarus-refresh-button
              data-idle-label="{{ labels.refresh }}" data-busy-label="{{ labels.refreshing }}">
        <i class="ti ti-refresh" aria-hidden="true"></i>
        <span>{% if loaded %}{{ labels.refresh }}{% else %}{{ labels.runInspection }}{% endif %}</span>
      </button>
    </form>
  </div>

  <div class="alert alert-secondary mt-3" role="note">
    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ labels.persistedState }}
  </div>

  <div class="alert alert-danger mt-3{% if error is null %} d-none{% endif %}" role="alert" data-clarus-error>
    {{ error ?? labels.technicalError }}
  </div>

  {% if error is null and loaded %}
    <div class="clarus-inspection__summary card mt-3" aria-label="{{ labels.title }}">
      <div class="clarus-inspection__metric">
        <strong>{{ evaluatedCount }}</strong><span>{{ labels.evaluated }}</span>
      </div>
      <div class="clarus-inspection__metric clarus-inspection__metric--match">
        <strong>{{ counts.match }}</strong><span>{{ labels.matchingRules }}</span>
      </div>
      <div class="clarus-inspection__metric clarus-inspection__metric--no-match">
        <strong>{{ counts.no_match }}</strong><span>{{ labels.nonMatchingRules }}</span>
      </div>
      <div class="clarus-inspection__metric clarus-inspection__metric--indeterminate">
        <strong>{{ counts.indeterminate }}</strong><span>{{ labels.indeterminate }}</span>
      </div>
      {% if overwriteCounts.possible > 0 or overwriteCounts.confirmed > 0 %}
        <div class="clarus-inspection__metric clarus-inspection__metric--possible-overwrite">
          <strong>{{ overwriteCounts.possible }}</strong><span>{{ labels.possibleOverwrite }}</span>
        </div>
        <div class="clarus-inspection__metric clarus-inspection__metric--confirmed-overwrite">
          <strong>{{ overwriteCounts.confirmed }}</strong><span>{{ labels.confirmedOverwrite }}</span>
        </div>
      {% endif %}
    </div>

    {% if truncated %}
      <div class="alert alert-warning mt-3" role="alert">
        <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>{{ labels.truncated }}
        ({{ evaluatedCount }}/{{ candidateCount }})
      </div>
    {% endif %}

    {% if rules is not empty %}
      <div class="clarus-inspection__controls card mt-3">
        <div class="clarus-inspection__control">
          <label class="form-label" for="clarus-search-{{ ticketId }}">{{ labels.searchAndFilter }}</label>
          <input class="form-control" id="clarus-search-{{ ticketId }}" type="search"
                 placeholder="{{ labels.searchPlaceholder }}" data-clarus-search>
        </div>
        <div class="clarus-inspection__control">
          <label class="form-label" for="clarus-group-{{ ticketId }}">{{ labels.grouping }}</label>
          <select class="form-select" id="clarus-group-{{ ticketId }}" data-clarus-group>
            <option value="processing"{% if initialGroup == 'processing' %} selected{% endif %}>{{ labels.groupProcessing }}</option>
            <option value="result"{% if initialGroup == 'result' %} selected{% endif %}>{{ labels.groupResult }}</option>
            <option value="entity"{% if initialGroup == 'entity' %} selected{% endif %}>{{ labels.groupEntity }}</option>
          </select>
        </div>
        <fieldset class="clarus-inspection__filters" aria-label="{{ labels.resultFilter }}">
          <legend>{{ labels.resultFilter }}</legend>
          <div class="btn-group" role="group" aria-label="{{ labels.resultFilter }}">
            <button class="btn btn-outline-secondary" type="button" data-clarus-result-all aria-pressed="true">{{ labels.all }}</button>
            <button class="btn btn-outline-secondary" type="button" value="match" data-clarus-result aria-pressed="true">{{ labels.matches }}</button>
            <button class="btn btn-outline-secondary" type="button" value="no_match" data-clarus-result aria-pressed="true">{{ labels.doesNotMatch }}</button>
            <button class="btn btn-outline-secondary" type="button" value="indeterminate" data-clarus-result aria-pressed="true">{{ labels.indeterminate }}</button>
          </div>
        </fieldset>
        <fieldset class="clarus-inspection__filters" aria-label="{{ labels.conflictFilter }}">
          <legend>{{ labels.conflictFilter }}</legend>
          <div class="btn-group" role="group" aria-label="{{ labels.conflictFilter }}">
            <button class="btn btn-outline-secondary" type="button" value="all" data-clarus-conflict aria-pressed="true">{{ labels.all }}</button>
            <button class="btn btn-outline-secondary" type="button" value="with" data-clarus-conflict aria-pressed="false">{{ labels.withConflict }}</button>
            <button class="btn btn-outline-secondary" type="button" value="possible" data-clarus-conflict aria-pressed="false">{{ labels.possibleOverwrite }}</button>
            <button class="btn btn-outline-secondary" type="button" value="confirmed" data-clarus-conflict aria-pressed="false">{{ labels.confirmedOverwrite }}</button>
          </div>
        </fieldset>
        <details class="clarus-inspection__compact-filter">
          <summary>{{ labels.conditionFilter }}</summary>
          <select class="form-select" multiple data-clarus-condition aria-label="{{ labels.conditionFilter }}">
            <option value="onadd" selected>{{ labels.onadd }}</option>
            <option value="onupdate" selected>{{ labels.onupdate }}</option>
          </select>
        </details>
        <details class="clarus-inspection__compact-filter">
          <summary>{{ labels.entityFilter }}</summary>
          <select class="form-select" multiple data-clarus-entity aria-label="{{ labels.entityFilter }}">
            {% for entity in entityOptions %}
              <option value="{{ entity.id }}" selected>{{ entity.name }}</option>
            {% endfor %}
          </select>
        </details>
        <details class="clarus-inspection__sort">
          <summary>{{ labels.sortBy }}</summary>
          {% for level in initialSort %}
            <div class="clarus-inspection__sort-level">
              <label class="visually-hidden" for="clarus-sort-field-{{ ticketId }}-{{ loop.index }}">{{ labels.sortLevel|format(loop.index) }}</label>
              <select class="form-select" id="clarus-sort-field-{{ ticketId }}-{{ loop.index }}" data-clarus-sort-field>
                <option value="">{{ labels.noSort }}</option>
                {% for value, label in sortOptions %}
                  <option value="{{ value }}"{% if value == level.field %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
              <label class="visually-hidden" for="clarus-sort-direction-{{ ticketId }}-{{ loop.index }}">{{ labels.sortLevel|format(loop.index) }}</label>
              <select class="form-select" id="clarus-sort-direction-{{ ticketId }}-{{ loop.index }}" data-clarus-sort-direction>
                <option value="asc"{% if level.direction == 'asc' %} selected{% endif %}>{{ labels.ascending }}</option>
                <option value="desc"{% if level.direction == 'desc' %} selected{% endif %}>{{ labels.descending }}</option>
              </select>
            </div>
          {% endfor %}
        </details>
      </div>

      <div class="clarus-inspection__results-heading">
        <h3>{{ labels.results }}</h3>
        <span class="text-muted" data-clarus-visible-count>{{ evaluatedCount }} {{ labels.rules }}</span>
      </div>

      <div class="clarus-inspection__rules" data-clarus-rules>
        {% for rule in rules %}
          <details class="clarus-rule card" data-clarus-rule data-evaluation="{{ rule.evaluationKey }}"
                   data-processing-index="{{ rule.processingIndex }}" data-evaluation-order="{{ rule.evaluationOrder }}"
                   data-entity="{{ rule.entitySort }}" data-entity-id="{{ rule.entityId }}" data-entity-label="{{ rule.entityName }}" data-search="{{ rule.searchText }}" data-condition="{{ rule.conditionKey }}"
                   data-adherence-numerator="{{ rule.adherenceNumerator }}" data-adherence-denominator="{{ rule.adherenceDenominator }}" data-matches="{{ rule.matchingCriteria }}"
                   data-criteria="{{ rule.criteriaCount }}" data-indeterminate="{{ rule.indeterminateCriteria }}"
                   data-ranking="{{ rule.ranking }}" data-actions="{{ rule.actionCount }}" data-name="{{ rule.name|lower }}" data-id="{{ rule.id }}"
                   data-conflicts="{{ rule.conflictKeys|join(' ') }}">
            <summary class="clarus-rule__summary" data-clarus-rule-toggle aria-expanded="false">
              <span class="clarus-rule__accent clarus-rule__accent--{{ rule.evaluationKey }}" aria-hidden="true"></span>
              <span class="clarus-rule__identity">
                <span class="clarus-rule__id">#{{ rule.id }}</span>
                <strong>{{ rule.name }}</strong>
                <span class="clarus-rule__metadata">
                  {{ labels.ranking }} {{ rule.ranking }}
                  <span aria-hidden="true">•</span> {{ labels.entity }}: {{ rule.entityName }}
                  <span aria-hidden="true">•</span> {{ rule.condition }}
                  <span aria-hidden="true">•</span> {{ labels.groupProcessing }}: {{ rule.processingIndex + 1 }}
                  <span aria-hidden="true">•</span> {{ labels.confirmedAdherence }}: {{ rule.adherenceLabel }}
                  {% if rule.indeterminateCriteria > 0 %}<span aria-hidden="true">•</span> {{ rule.indeterminateCriteria }} {{ labels.indeterminateCriteria }}{% endif %}
                  <span aria-hidden="true">•</span> {{ rule.actionSummary }}
                </span>
              </span>
              <span class="clarus-rule__status">
                {% if rule.indeterminateCriteria > 0 %}
                  <span class="clarus-rule__indeterminate" title="{{ labels.cannotSafelyEvaluate }}" aria-label="{{ labels.cannotSafelyEvaluate }}"><i class="ti ti-help-circle" aria-hidden="true"></i></span>
                {% endif %}
                <span class="clarus-rule__badge clarus-rule__badge--{{ rule.evaluationKey }}">{{ rule.evaluationLabel }}</span>
                {% for conflict in rule.conflictKeys %}
                  <span class="clarus-rule__conflict-badge clarus-rule__conflict-badge--{{ conflict }}">
                    {% if conflict == 'confirmed' %}{{ labels.confirmedOverwrite }}{% else %}{{ labels.possibleOverwrite }}{% endif %}
                  </span>
                {% endfor %}
                <i class="ti ti-chevron-down clarus-rule__chevron" aria-hidden="true"></i>
              </span>
            </summary>

            <div class="clarus-rule__details">
              {% if rule.indeterminateCriteria > 0 %}
                <p class="clarus-rule__indeterminate-note"><i class="ti ti-help-circle" aria-hidden="true"></i>{{ labels.cannotSafelyEvaluate }}</p>
              {% endif %}
              {% if rule.limitations is not empty %}
                <ul class="alert alert-secondary" role="list">
                  {% for limitation in rule.limitations %}<li>{{ limitation }}</li>{% endfor %}
                </ul>
              {% endif %}

              {% if rule.overwrites is not empty %}
                <section class="clarus-rule__sequential" aria-label="{{ labels.sequentialDiagnostic }}">
                  <h4>{{ labels.sequentialDiagnostic }}</h4>
                  {% for overwrite in rule.overwrites %}
                    <article class="clarus-rule__overwrite clarus-rule__overwrite--{{ overwrite.classification }}">
                      <div>
                        <strong>{% if overwrite.classification == 'confirmed' %}{{ labels.confirmedOverwrite }}{% else %}{{ labels.possibleOverwrite }}{% endif %}</strong>
                        <span>{{ labels.affectedField }}: {{ overwrite.fieldLabel }}</span>
                      </div>
                      <p class="mb-1"><span class="visually-hidden">{{ labels.ruleChain }}: </span>{% for ruleId in overwrite.chainRuleIds %}#{{ ruleId }}{% if not loop.last %} <span aria-hidden="true">→</span> {% endif %}{% endfor %}</p>
                      <p class="text-muted mb-0">
                        {% if overwrite.classification == 'confirmed' %}
                          {{ labels.confirmedOverwriteNotice }}
                        {% else %}
                          {{ overwrite.reason ?? labels.possibleOverwriteNotice }}
                        {% endif %}
                      </p>
                    </article>
                  {% endfor %}
                </section>
              {% endif %}

              <h4>{{ labels.criteria }}</h4>
              {% if rule.criteria is empty %}
                <p class="text-muted">{{ labels.empty }}</p>
              {% else %}
                <div class="clarus-diagnostic-grid clarus-diagnostic-grid--criteria">
                  <div class="clarus-diagnostic-grid__header" aria-hidden="true">
                    <span></span><span>{{ labels.criterion }}</span><span>{{ labels.operator }}</span>
                    <span>{{ labels.expected }}</span><span>{{ labels.observed }}</span>
                  </div>
                  {% for criterion in rule.criteria %}
                    <div class="clarus-diagnostic-grid__row">
                      <span class="clarus-criterion-state clarus-criterion-state--{{ criterion.evaluationKey }}">{{ criterion.state }}</span>
                      <span data-label="{{ labels.criterion }}">{{ criterion.name }}</span>
                      <span data-label="{{ labels.operator }}">{{ criterion.operator }}</span>
                      <span data-label="{{ labels.expected }}">{{ criterion.expected }}</span>
                      <span data-label="{{ labels.observed }}">
                        {{ criterion.observed }}
                        {% if criterion.limitation is not null %}<small class="clarus-diagnostic-grid__context text-muted"><i class="ti ti-help-circle" aria-hidden="true"></i>{{ criterion.limitation }}</small>{% endif %}
                      </span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="clarus-actions">
                <h4>{{ labels.configuredActions }}</h4>
                <div class="alert alert-info py-2" role="note">
                  <i class="ti ti-info-circle me-1" aria-hidden="true"></i>{{ labels.noActionsExecuted }}
                  {{ labels.actionReflectionNotice }}
                </div>
                {% if not rule.actionsEnabled %}
                  <p class="text-muted">{{ labels.actionAnalysisDisabled }}</p>
                {% elseif rule.actions is not empty %}
                  <div class="clarus-diagnostic-grid clarus-diagnostic-grid--actions">
                    <div class="clarus-diagnostic-grid__header" aria-hidden="true">
                      <span>{{ labels.action }}</span><span>{{ labels.field }}</span><span>{{ labels.configuredValue }}</span>
                      <span>{{ labels.currentValue }}</span><span>{{ labels.support }}</span><span>{{ labels.reflection }}</span>
                    </div>
                    {% for action in rule.actions %}
                      <div class="clarus-diagnostic-grid__row">
                        <span data-label="{{ labels.action }}">{{ action.type }}</span>
                        <span data-label="{{ labels.field }}">{{ action.field }}</span>
                        <span data-label="{{ labels.configuredValue }}">{{ action.configured }}</span>
                        <span data-label="{{ labels.currentValue }}">{{ action.current }}</span>
                        <span data-label="{{ labels.support }}">{{ action.support }}</span>
                        <span data-label="{{ labels.reflection }}">
                          {{ action.evaluation }}
                          {% if action.limitation is not null %}<small class="clarus-diagnostic-grid__context text-muted"><i class="ti ti-help-circle" aria-hidden="true"></i>{{ action.limitation }}</small>{% endif %}
                        </span>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <details class="clarus-rule__technical">
                <summary data-clarus-technical-toggle aria-expanded="false">{{ labels.technicalDetails }}</summary>
                <dl>
                  <div><dt>{{ labels.groupProcessing }}</dt><dd>{{ rule.processingIndex + 1 }}</dd></div>
                  <div><dt>{{ labels.ranking }}</dt><dd>{{ rule.ranking }}</dd></div>
                  <div><dt>{{ labels.condition }}</dt><dd>{{ rule.condition }}</dd></div>
                  <div><dt>{{ labels.entity }}</dt><dd>{{ rule.entityName }}</dd></div>
                </dl>
              </details>
            </div>
          </details>
        {% endfor %}
      </div>

      <div class="alert alert-secondary d-none mt-3" role="status" data-clarus-filter-empty>{{ labels.noFilteredResults }}</div>
      <div class="clarus-inspection__pagination mt-3">
        <span class="text-muted" data-clarus-page-summary></span>
        <nav aria-label="{{ labels.results }}"><div class="btn-group" data-clarus-pagination></div></nav>
      </div>
    {% else %}
      <div class="clarus-inspection__empty card mt-3" role="status">{{ labels.empty }}</div>
    {% endif %}
  {% elseif error is null %}
    <div class="clarus-inspection__empty card mt-3" role="status">{{ labels.notLoaded }}</div>
  {% endif %}
</section>
