{
  "name": "renatovaladares85/clarus",
  "description": "Read-only diagnostic inspection of GLPI Ticket business rules.",
  "type": "glpi-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1 <8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.80",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer-validate": "@composer validate --strict",
    "composer-audit": "@composer audit --locked --no-interaction",
    "lint": "@php tools/lint.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
    "test": "phpunit --colors=always",
    "qa": [
      "@composer-validate",
      "@composer-audit",
      "@lint",
      "@cs:check",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
