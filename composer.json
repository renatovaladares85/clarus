{
  "name": "renatovaladares85/clarus",
  "description": "Read-only diagnostic inspection of GLPI Ticket business rules.",
  "type": "glpi-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1 <8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.80",
    "glpi-project/coding-standard": "^0.9",
    "glpi-project/tools": "^0.8",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer-validate": "@composer validate --strict",
    "composer-audit": "@composer audit --locked --no-interaction --abandoned=ignore",
    "lint": "@php tools/lint.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyze --memory-limit=2G --no-progress",
    "test": "phpunit --exclude-group glpi-integration --colors=always",
    "qa": [
      "@composer-validate",
      "@composer-audit",
      "@lint",
      "@cs:check",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
