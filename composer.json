{
  "name": "renatovaladares85/clarus",
  "description": "Read-only diagnostic inspection of GLPI Ticket business rules.",
  "type": "glpi-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1 <8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlpiPlugin\\Clarus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "@php tools/lint.php",
    "test": "phpunit --colors=always",
    "qa": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
